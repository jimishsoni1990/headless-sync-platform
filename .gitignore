# Plugin dependencies — regenerate with: composer dump-autoload in headless-sync/
headless-sync/vendor/

# PHPUnit test cache
.phpunit.result.cache
**/.phpunit.result.cache

# Plugin runtime storage
headless-sync/storage/*
!headless-sync/storage/.gitkeep

# Node dependencies (Next.js frontend + the React admin-UI toolchain).
# The bare pattern ignores node_modules/ everywhere, including
# headless-sync/resources/admin-ui/node_modules/.
node_modules/

# React admin UI (DECISION W (a)): the toolchain builds in dev/CI, but the compiled bundle is
# COMMITTED (production deploy is a file copy, no host build step). So dist/ must NOT be ignored.
!headless-sync/resources/admin-ui/dist/

# OS
.DS_Store
Thumbs.db

# Claude Code harness config (local, not part of the project)
.claude/
