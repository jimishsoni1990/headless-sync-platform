# Normalize text files in the repository, and check them out with LF endings
# regardless of the developer's core.autocrlf setting.
#
# Why (FLAG-DOCRECON-1, 2026-09-05): with core.autocrlf=true on Windows, PHP
# files are checked out CRLF, and PHPCS's Generic.Files.LineEndings.InvalidEOLChar
# sniff (PSR-12, phpcs.xml.dist) then fails on every affected file. The blobs in
# git were always LF; only working copies drifted. eol=lf pins the working copy
# so `composer lint` is reproducible on every machine and in CI.

* text=auto

*.php  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.neon text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.sql  text eol=lf

# Binary — never touch
*.phar binary
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary

# `*.xml` / `*.neon` do not match `phpcs.xml.dist` / `phpstan.neon.dist` — the
# extension is `.dist`. Match those explicitly so tool configs stay LF too.
*.dist text eol=lf
