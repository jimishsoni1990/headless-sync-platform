{
    "name": "hsp/headless-sync",
    "description": "Headless Sync Platform — WordPress to PostgreSQL event-driven sync pipeline",
    "type": "wordpress-plugin",
    "autoload": {
        "psr-4": {
            "HSP\\Bootstrap\\": "bootstrap/",
            "HSP\\Core\\": "core/",
            "HSP\\Database\\": "database/",
            "HSP\\Modules\\": "modules/",
            "Psr\\Container\\": "core/Psr/Container/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HSP\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=1G -c phpstan.neon.dist",
        "lint": "phpcs -q",
        "lint:fix": "phpcbf --standard=PSR12 bootstrap config core database modules headless-sync.php"
    },
    "scripts-descriptions": {
        "analyse": "PHPStan static analysis (level 8, baseline-green).",
        "lint": "PHPCS: PSR-12 (all platform code) + WPCS security sniffs (WP entry points).",
        "lint:fix": "phpcbf — auto-fix PSR-12 formatting ONLY. Never fixes WPCS security sniffs."
    }
}
